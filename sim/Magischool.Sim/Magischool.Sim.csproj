<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Magischool.Sim</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The sim must stay engine-agnostic: no Godot references in this project. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Magischool.Sim.Tests" />
  </ItemGroup>

</Project>
