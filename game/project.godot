; Engine configuration file.
; Bare-bones viewer for the Magischool simulation. All world logic lives in
; ../sim/Magischool.Sim; this project only draws it and forwards input.

config_version=5

[application]

config/name="Magischool"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[dotnet]

project/assembly_name="Magischool.Game"
project/solution_directory=".."

[rendering]

textures/canvas_textures/default_texture_filter=0
